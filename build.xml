<?xml version="1.0" encoding="UTF-8"?>
<project name="UICC HOTP" default="build-applet" basedir=".">

	<!-- <get src="https://github.com/martinpaljak/ant-javacard/releases/latest/download/ant-javacard.jar" dest="." skipexisting="true"/> -->
	<taskdef name="javacard" classname="pro.javacard.ant.JavaCard" classpath="ant-javacard.jar"/>

    <description>UICC applet that features HOTP generation</description>

    <target name="build-applet" description="generate the distribution">
        <mkdir dir="out"/>
        <tstamp/>
        <javacard jckit="./libraries/jc304_kit">
            <cap aid="A0:00:00:00:87" output="out/UICC_HOTP.cap" sources="src" version="1.0" ints="true">
                <applet class="fun.hotp.UICC_HOTP" aid="A0:00:00:00:87:53:49:4D:20:48:4F:54:50"/>
                
                <import jar="libraries/ts_102241_09/uicc-api-for-java-card-REL-920.jar"/>
            </cap>
        </javacard>
    </target>

    <target name="clean" description="Delete previously created out folder with all its content">
        <delete dir="out"/>
    </target>

</project>
